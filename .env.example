# Copy to .env.local for local preview. On Cloudflare Pages set these under
# Settings → Environment variables. All values are PUBLIC (embedded in HTML/JS):
# never put secrets in VITE_* variables.

# Canonical site URL (no trailing slash). Used for canonical/OG/sitemap.
VITE_SITE_URL=https://web.mhmacademy.site

# WhatsApp number in international format, digits only (e.g. 60XXXXXXXXX).
# Leave empty until the official business number is confirmed — the site then
# shows a copy-the-message fallback instead of a WhatsApp button.
VITE_WHATSAPP_NUMBER=

# Official contact email. Leave empty until confirmed.
VITE_CONTACT_EMAIL=

# MHM Academy URL shown in the ecosystem sections.
VITE_ACADEMY_URL=https://mhmacademy.site
