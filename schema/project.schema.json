{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web.mhmacademy.site/schema/project.schema.json",
  "title": "MHM CENTER portfolio project",
  "description": "Metadata for a portfolio project. Place as .mhm-portfolio.json in a repository tagged with the 'mhm-portfolio' topic, or as content/projects/<slug>.json in the portfolio repo. Authoritative rules live in src/features/portfolio/schema.ts.",
  "type": "object",
  "required": [
    "slug",
    "title",
    "description",
    "category",
    "projectType",
    "status"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 64
    },
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "tagline": {
      "type": "string",
      "minLength": 4,
      "maxLength": 140
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 420
    },
    "category": {
      "enum": [
        "landing-page",
        "website",
        "ecommerce",
        "web-app",
        "crm-erp",
        "saas",
        "ai-automation",
        "marketing-automation"
      ]
    },
    "projectType": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    },
    "technologies": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "maxLength": 32
      }
    },
    "demoUrl": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https://"
    },
    "repositoryReference": {
      "type": [
        "string",
        "null"
      ],
      "description": "Ignored for discovered repos (forced to the source repo)."
    },
    "thumbnail": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "src",
            "alt",
            "width",
            "height"
          ],
          "additionalProperties": false,
          "properties": {
            "src": {
              "type": "string",
              "description": "/projects/<slug>/file.webp (this repo) or https://raw.githubusercontent.com/<owner>/<same-repo>/..."
            },
            "alt": {
              "type": "string",
              "minLength": 3,
              "maxLength": 160
            },
            "width": {
              "type": "integer",
              "minimum": 16,
              "maximum": 8000
            },
            "height": {
              "type": "integer",
              "minimum": 16,
              "maximum": 12000
            },
            "caption": {
              "type": "string",
              "maxLength": 200
            },
            "frame": {
              "enum": [
                "desktop",
                "mobile"
              ]
            },
            "srcset": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "galleryImages": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": [
          "src",
          "alt",
          "width",
          "height"
        ],
        "additionalProperties": false,
        "properties": {
          "src": {
            "type": "string",
            "description": "/projects/<slug>/file.webp (this repo) or https://raw.githubusercontent.com/<owner>/<same-repo>/..."
          },
          "alt": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160
          },
          "width": {
            "type": "integer",
            "minimum": 16,
            "maximum": 8000
          },
          "height": {
            "type": "integer",
            "minimum": 16,
            "maximum": 12000
          },
          "caption": {
            "type": "string",
            "maxLength": 200
          },
          "frame": {
            "enum": [
              "desktop",
              "mobile"
            ]
          },
          "srcset": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "featured": {
      "type": "boolean"
    },
    "displayOrder": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999
    },
    "approvedForPublic": {
      "type": "boolean",
      "default": false,
      "description": "For discovered repos this is only a request; publication requires content/approvals.json in the portfolio repo."
    },
    "status": {
      "enum": [
        "production",
        "demo",
        "prototype",
        "in-development"
      ]
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "caseStudy": {
      "type": "object",
      "properties": {
        "intro": {
          "type": "string",
          "maxLength": 900
        },
        "challenge": {
          "type": "string",
          "maxLength": 900
        },
        "solution": {
          "type": "string",
          "maxLength": 900
        },
        "features": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": [
              "title",
              "description"
            ],
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 80
              },
              "description": {
                "type": "string",
                "maxLength": 320
              }
            }
          }
        },
        "demoNotes": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "maxLength": 240
          }
        },
        "tryIt": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    }
  }
}
