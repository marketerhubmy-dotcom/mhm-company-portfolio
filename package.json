{
  "name": "mhm-company-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "MHM CENTER — portfolio rasmi syarikat (React + Vite + prerender, Cloudflare Pages).",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "npm run portfolio:compile && vite",
    "portfolio:compile": "tsx scripts/sync-portfolio.ts --offline",
    "portfolio:sync": "tsx scripts/sync-portfolio.ts",
    "validate": "tsx scripts/validate-content.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "tsx scripts/prerender.ts",
    "build": "npm run portfolio:compile && npm run validate && npm run build:client && npm run build:server && npm run prerender",
    "preview": "vite preview --port 4173",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  }
}
